rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(guildId, userId) {
      return /databases/$(database)/documents/guilds/$(guildId)/members/$(userId);
    }

    function hasGuildRole(guildId, allowedRoles) {
      return signedIn()
        && exists(memberPath(guildId, request.auth.uid))
        && get(memberPath(guildId, request.auth.uid)).data.role in allowedRoles;
    }

    function isGuildLeader(guildId) {
      return hasGuildRole(guildId, ['Guild Leader']);
    }

    function canManageRaid(guildId) {
      return hasGuildRole(guildId, ['Guild Leader', 'Raid Leader']);
    }

    function hasValidRole() {
      return request.resource.data.role in ['Guild Leader', 'Raid Leader', 'Member'];
    }

    function validMemberAccessChange(userId) {
      let after = request.resource.data;
      return (hasValidRole() || after.role == 'Removed')
        && (after.role != 'Removed' || (request.auth.uid != userId && after.get('playerId', null) == null))
        && (resource.data.role != 'Removed'
          || (after.role in ['Removed', 'Member'] && after.get('playerId', null) == null));
    }

    function hasValidPlayerLink(guildId, userId) {
      let playerId = request.resource.data.get('playerId', null);
      return playerId == null
        || (playerId is string
          && getAfter(/databases/$(database)/documents/guilds/$(guildId)/roster/$(playerId)).data.linkedUid == userId);
    }

    function releasesPreviousPlayerLink(guildId, userId) {
      let previousPlayerId = resource.data.get('playerId', null);
      let nextPlayerId = request.resource.data.get('playerId', null);
      return previousPlayerId == null
        || previousPlayerId == nextPlayerId
        || getAfter(/databases/$(database)/documents/guilds/$(guildId)/roster/$(previousPlayerId)).data.get('linkedUid', null) != userId;
    }

    function hasValidRosterLink(guildId, playerId) {
      let linkedUid = request.resource.data.get('linkedUid', null);
      return linkedUid == null
        || (linkedUid is string
          && getAfter(memberPath(guildId, linkedUid)).data.playerId == playerId
          && getAfter(memberPath(guildId, linkedUid)).data.role != 'Removed');
    }

    function releasesPreviousMemberLink(guildId, playerId) {
      let previousUid = resource.data.get('linkedUid', null);
      let nextUid = request.resource.data.get('linkedUid', null);
      return previousUid == null
        || previousUid == nextUid
        || getAfter(memberPath(guildId, previousUid)).data.get('playerId', null) != playerId;
    }

    function validMemberComment(guildId) {
      let data = request.resource.data;
      return hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member'])
        && data.keys().hasOnly(['userId', 'displayName', 'text', 'updatedAt'])
        && data.keys().hasAll(['userId', 'displayName', 'text', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.displayName == get(memberPath(guildId, request.auth.uid)).data.displayName
        && data.text is string
        && data.text.trim().size() >= 1
        && data.text.size() <= 300
        && data.updatedAt == request.time;
    }

    function hasPrioritySnapshot(guildId) {
      let priorityPath = /databases/$(database)/documents/guilds/$(guildId)/lootPriorities/$(request.resource.data.priorityId);
      return request.resource.data.priorityId is string
        && exists(priorityPath)
        && request.resource.data.prioritySnapshot == get(priorityPath).data.rankedPlayers
        && request.resource.data.councilNoteSnapshot == get(priorityPath).data.councilNote
        && request.resource.data.item == get(priorityPath).data.item
        && request.resource.data.encounter == get(priorityPath).data.encounter
        && (request.resource.data.recipient in get(priorityPath).data.rankedPlayers
          || ('recipientId' in request.resource.data
            && (request.resource.data.recipientId in get(priorityPath).data.get('rankedIds', []) || '' in get(priorityPath).data.get('rankedIds', []))))
        && ((!('prioritySnapshotIds' in request.resource.data) && !('recipientId' in request.resource.data))
          || request.resource.data.get('prioritySnapshotIds', []) == get(priorityPath).data.get('rankedIds', []))
        && !('hidden' in get(priorityPath).data)
        && validPhaseNo(request.resource.data.phaseNo)
        && request.resource.data.phaseNo == get(priorityPath).data.get('phaseNo', 0);
    }

    // A loot phase number: a whole number of 0 to 30 (a guild can have at most 30 finished phases, so the current one is at most 30).
    function validPhaseNo(value) {
      return value is int && value >= 0 && value <= 30;
    }

    // The number of the current loot phase: how many finished phases the settings list (see validPhaseHistory). A guild that never saved its
    // settings is in phase 0. The two lookups are shared by every write in a batch.
    function currentPhaseNo(guildId) {
      let settingsPath = /databases/$(database)/documents/guilds/$(guildId)/settings/general;
      return exists(settingsPath) ? get(settingsPath).data.get('phaseHistory', []).size() : 0;
    }

    // The entry at `path` is one this request writes. An entry stays for ever, so one left from an earlier life of the same id (a priority that
    // was created, changed and deleted) would satisfy a plain existence check and let a write go unlogged; `at` is the server time of the request
    // that wrote the entry (the entry rule requires it), so only an entry written in this very batch passes. getAfter also fails when there is none.
    function writtenNow(path) {
      return getAfter(path).data.at == request.time;
    }

    // A priority is written only together with its audit entry (type 'priority'), in the same batch, like an award edit or a raid edit.
    // Its fields are bounded, rev goes up by one on every change, and updatedBy and updatedAt are stamped by the rules. A priority can be
    // created, changed or deleted only in the current phase or the next one (a finished phase is a record), and never moved to another
    // phase. A field that is not changed is not checked again, so a document written before these limits can still be reordered.
    function validGameId(value) {
      return value is int && value > 0 && value <= 100000000;
    }

    // The roster ids behind a priority's candidates (LOOT-003), one per line of `rankedPlayers` and in the same order. A line is a roster character
    // (its id), an open note ('': an idea such as "any warlock who didn't get X", not a person) or a finished note ('!'). The names stay as the
    // snapshot of what each line said when it was written. The rules check the shape only: a list as long as the names. They do not check the
    // elements (an id is only compared, never used as a path) or that each id is on the roster, which would need a lookup per candidate when a
    // request may make 20. An award is checked against the roster instead (validPriorityAward).
    function validRankedIds(after) {
      return after.rankedIds is list
        && after.rankedIds.size() <= 60
        && after.rankedIds.size() == after.rankedPlayers.size();
    }

    function validPriorityFields(before, after) {
      return (unchanged(before, after, 'item') || (after.item is string && after.item.size() >= 1 && after.item.size() <= 120))
        && (unchanged(before, after, 'encounter') || (after.encounter is string && after.encounter.size() <= 120))
        && (unchanged(before, after, 'rankedPlayers') || (after.rankedPlayers is list && after.rankedPlayers.size() <= 60))
        && (unchanged(before, after, 'councilNote') || (after.councilNote is string && after.councilNote.size() <= 500))
        && (!('rankedIds' in after) || (unchanged(before, after, 'rankedIds') && unchanged(before, after, 'rankedPlayers')) || validRankedIds(after))
        && (!('itemId' in after) || validGameId(after.itemId))
        && (!('zoneId' in after) || validGameId(after.zoneId))
        && (!('npcId' in after) || validGameId(after.npcId))
        && (!('carriedFrom' in after) || (after.carriedFrom is string && after.carriedFrom.matches('^[A-Za-z0-9_-]{1,100}$')))
        && (!('hidden' in after) || after.hidden == true);
    }

    // `hidden` (only ever true, and only on an edit: a priority is never created hidden) takes a priority off the list while keeping it, its candidate
    // list and the awards recorded from it, so ticking the item again in Browse drops brings it back as it was. No award can be made from a hidden priority.
    function validPriorityCreate(guildId, priorityId) {
      let data = request.resource.data;
      let current = currentPhaseNo(guildId);
      return data.keys().hasOnly(['item', 'encounter', 'rankedPlayers', 'rankedIds', 'councilNote', 'itemId', 'zoneId', 'npcId', 'phaseNo', 'carriedFrom', 'rev', 'updatedBy', 'updatedAt'])
        && data.keys().hasAll(['item', 'encounter', 'rankedPlayers', 'councilNote', 'phaseNo', 'rev', 'updatedBy', 'updatedAt'])
        && data.rev is int && data.rev == 1
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time
        && validPriorityFields({}, data)
        && data.phaseNo is int && (data.phaseNo == current || data.phaseNo == current + 1)
        && writtenNow(auditEntryPath(guildId, 'priority', priorityId, 1));
    }

    function validPriorityEdit(guildId, priorityId) {
      let before = resource.data;
      let after = request.resource.data;
      let current = currentPhaseNo(guildId);
      let rev = before.get('rev', 0) + 1;
      let entryPath = auditEntryPath(guildId, 'priority', priorityId, rev);
      return after.keys().hasOnly(['item', 'encounter', 'rankedPlayers', 'rankedIds', 'councilNote', 'itemId', 'zoneId', 'npcId', 'phaseNo', 'carriedFrom', 'hidden', 'rev', 'updatedBy', 'updatedAt'])
        && before.get('rev', 0) is int
        && after.rev is int
        && after.rev == rev
        && writtenNow(entryPath)
        && getAfter(entryPath).data.targetType == 'priority'
        && getAfter(entryPath).data.targetId == priorityId
        && after.updatedBy == request.auth.uid
        && after.updatedAt == request.time
        && unchanged(before, after, 'phaseNo')
        && unchanged(before, after, 'carriedFrom')
        && (before.get('phaseNo', 0) == current || before.get('phaseNo', 0) == current + 1)
        && validPriorityFields(before, after);
    }

    function validPriorityDelete(guildId, priorityId) {
      let before = resource.data;
      let current = currentPhaseNo(guildId);
      return before.get('rev', 0) is int
        && (before.get('phaseNo', 0) == current || before.get('phaseNo', 0) == current + 1)
        && writtenNow(auditEntryPath(guildId, 'priority', priorityId, before.get('rev', 0) + 1));
    }

    // Loot tables: the guild's own changes to the drop lists of Browse drops, one document per zone (type 'zone') and one per creature (type 'source', also
    // the zone-wide list) PER PHASE. A document carries the loot phase it was written in (`phaseNo`) and means "from this phase on, until a later phase's
    // document says otherwise": the app works out the lists of a phase by applying, in phase order, the documents of that phase and the earlier ones to the
    // built-in captures, so a phase with no documents has the lists of the one before it and a change in one phase never reaches an earlier one. Like a
    // priority, a table document can be created or changed only in the current phase or the next one (a finished phase's lists are a record), and its
    // phase never changes. Written only with the audit entry (type 'table') in the same batch, rev up by one, updatedBy and updatedAt stamped here.
    // A document says only what its phase changes, so every attribute (name, kind, size, order, creature number) is optional and checked when it is there.
    // A custom zone's number is 50 million or more, clear of the game's own zones; a zone of the built-in captures has only a "presence" document that says
    // whether it is in the lists from its phase on (`removed`). A creature's document holds itemIds added in its phase and hiddenItemIds taken off from its
    // phase on, which cannot share an item. A table is never deleted (an entry id is used once, so a deleted id could never be created again): taking one
    // away is `removed: true`, bringing it back `removed: false`, and both are plain edits. A creature of the built-in captures (key npc{id}) and the
    // zone-wide list can never be removed (their items can only be hidden). Only the sizes of the lists are checked; the app reads them safely, as it does
    // a priority's candidates.
    //
    // A third kind, one per phase (type 'phase', id p{phaseNo}), says which EARLIER phase this one follows (`follows`, a phase number below its own, or
    // no `follows` at all for a phase that follows nothing). A phase that follows another has that phase's lists (zones, creatures, items) with its own
    // documents on top, and the followed phase's lists in turn include what it follows. The number is always lower than the phase's own, so following
    // never loops. It is an ordinary audited document: created or changed only in the current phase or the next one, never deleted (taking the link
    // away is an edit that removes `follows`).
    function tableKeysOk(data, creating) {
      return data.type == 'phase'
        ? data.keys().hasOnly(['type', 'phaseNo', 'follows', 'rev', 'updatedBy', 'updatedAt'])
          && data.keys().hasAll(['type', 'phaseNo', 'rev', 'updatedBy', 'updatedAt'])
        : tableKeysOfZoneOrSource(data, creating);
    }

    function tableKeysOfZoneOrSource(data, creating) {
      return validGameId(data.zoneId)
        && (data.type == 'source'
          ? data.keys().hasOnly(['type', 'zoneId', 'key', 'phaseNo', 'name', 'kind', 'npcId', 'order', 'itemIds', 'hiddenItemIds', 'removed', 'rev', 'updatedBy', 'updatedAt'])
            && data.keys().hasAll(['type', 'zoneId', 'key', 'phaseNo', 'itemIds', 'hiddenItemIds', 'rev', 'updatedBy', 'updatedAt'])
          : data.type == 'zone'
            && (data.zoneId >= 50000000
              ? data.keys().hasOnly(['type', 'zoneId', 'phaseNo', 'name', 'kind', 'players', 'removed', 'rev', 'updatedBy', 'updatedAt'])
                && data.keys().hasAll(['type', 'zoneId', 'phaseNo', 'rev', 'updatedBy', 'updatedAt'])
              : data.keys().hasOnly(['type', 'zoneId', 'phaseNo', 'removed', 'rev', 'updatedBy', 'updatedAt'])
                && data.keys().hasAll(creating ? ['type', 'zoneId', 'phaseNo', 'removed', 'rev', 'updatedBy', 'updatedAt'] : ['type', 'zoneId', 'phaseNo', 'rev', 'updatedBy', 'updatedAt'])));
    }

    function validTableName(value) {
      return value is string && value.trim().size() >= 1 && value.size() <= 100;
    }

    function validTableFields(after) {
      return (after.type == 'phase'
          ? !('follows' in after) || (after.follows is int && after.follows >= 0 && after.follows < after.phaseNo)
          : after.type == 'zone'
          ? after.zoneId < 50000000
            || ((!('name' in after) || validTableName(after.name))
              && (!('kind' in after) || after.kind in ['dungeon', 'raid'])
              && (!('players' in after) || (after.players is int && after.players >= 1 && after.players <= 40)))
          : (!('name' in after) || validTableName(after.name))
            && (!('kind' in after) || (after.kind in ['boss', 'rare', 'trash', 'zonewide'] && (after.kind == 'zonewide') == (after.key == 'zonewide')))
            && (!('npcId' in after) || validGameId(after.npcId))
            && (!('order' in after) || (after.order is int && after.order >= 0 && after.order <= 100000))
            && (!('itemIds' in after) || (after.itemIds is list && after.itemIds.size() <= 80))
            && (!('hiddenItemIds' in after) || (after.hiddenItemIds is list && after.hiddenItemIds.size() <= 80))
            && !after.itemIds.hasAny(after.hiddenItemIds)
            && !(after.get('removed', false) == true && (after.key == 'zonewide' || after.key.matches('^npc[0-9]+$'))))
        && (!('removed' in after) || after.removed is bool);
    }

    function validTableCreate(guildId, tableId) {
      let data = request.resource.data;
      let current = currentPhaseNo(guildId);
      return data.rev is int && data.rev == 1
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time
        && data.phaseNo is int && (data.phaseNo == current || data.phaseNo == current + 1)
        && tableKeysOk(data, true)
        && (data.type == 'phase'
          ? tableId == 'p' + string(data.phaseNo)
          : data.type == 'zone'
          ? tableId == 'z' + string(data.zoneId) + '_' + string(data.phaseNo)
          : data.key is string && data.key.matches('^[A-Za-z0-9]{1,30}$')
            && tableId == 's' + string(data.zoneId) + '_' + data.key + '_' + string(data.phaseNo))
        && validTableFields(data)
        && writtenNow(auditEntryPath(guildId, 'table', tableId, 1));
    }

    function validTableEdit(guildId, tableId) {
      let before = resource.data;
      let after = request.resource.data;
      let current = currentPhaseNo(guildId);
      let rev = before.get('rev', 0) + 1;
      let entryPath = auditEntryPath(guildId, 'table', tableId, rev);
      return tableKeysOk(after, false)
        && before.get('rev', 0) is int
        && after.rev is int
        && after.rev == rev
        && writtenNow(entryPath)
        && getAfter(entryPath).data.targetType == 'table'
        && getAfter(entryPath).data.targetId == tableId
        && after.updatedBy == request.auth.uid
        && after.updatedAt == request.time
        && unchanged(before, after, 'type')
        && unchanged(before, after, 'zoneId')
        && unchanged(before, after, 'key')
        && unchanged(before, after, 'phaseNo')
        && after.phaseNo is int
        && (before.phaseNo == current || before.phaseNo == current + 1)
        && validTableFields(after);
    }

    // An award made from a priority. It copies the priority as it stands (hasPrioritySnapshot), is recorded in the current phase, carries
    // the stamps the rules set (rev 1, createdBy, createdAt), and needs its audit entry (type 'award', revision 1) in the same batch.
    // With roster ids (LOOT-003) it also carries `recipientId`, a roster character that has the recipient's name now (a rename since the priority was
    // written is fine), and `prioritySnapshotIds`, the priority's ids as they stand (like the names, as the council saw them: get() reads the priority
    // as it was before the batch, so an award and the priority edit that adds the winner as a line can travel together). The recipient has to be on
    // the list, by name or by id, or the priority has an open note ('' in its ids), which is how someone the list does not name receives an item.
    function validPriorityAward(guildId, awardId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['priorityId', 'item', 'encounter', 'recipient', 'recipientId', 'awardedAt', 'prioritySnapshot', 'prioritySnapshotIds', 'councilNoteSnapshot', 'awardNote', 'phaseNo', 'rev', 'createdBy', 'createdAt'])
        && data.keys().hasAll(['priorityId', 'item', 'encounter', 'recipient', 'awardedAt', 'prioritySnapshot', 'councilNoteSnapshot', 'awardNote', 'phaseNo', 'rev', 'createdBy', 'createdAt'])
        && data.rev is int && data.rev == 1
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time
        && data.recipient is string && data.recipient.size() >= 1 && data.recipient.size() <= 60
        && (!('recipientId' in data) || (data.recipientId is string && data.recipientId.matches('^[A-Za-z0-9_-]{1,100}$')
          && get(/databases/$(database)/documents/guilds/$(guildId)/roster/$(data.recipientId)).data.name == data.recipient))
        && validIsoDate(data.awardedAt)
        && data.awardNote is string && data.awardNote.size() <= 500
        && data.phaseNo == currentPhaseNo(guildId)
        && hasPrioritySnapshot(guildId)
        && writtenNow(auditEntryPath(guildId, 'award', awardId, 1));
    }

    // A manual award is recorded without a priority, for example a need-before-greed roll or a decision made on the night.
    // It carries no priorityId and no snapshot, so nothing pretends that a candidate order existed. The recipient is a roster
    // character, by id, and the recipient name is the one the roster has now (a later rename does not rewrite the award).
    // `decision` says how it was decided and `phaseNo` is the loot phase it belongs to (see validPhaseHistory). awardedAt is the raid date and is kept apart from createdAt, the time of entry. The
    // audit entry (type 'award', revision 1) has to be written in the same batch; its own rule ties it back to this document.
    function validManualAward(guildId, awardId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['item', 'encounter', 'recipient', 'recipientId', 'awardedAt', 'awardNote', 'decision', 'phaseNo', 'rev', 'createdBy', 'createdAt'])
        && data.keys().hasAll(['item', 'encounter', 'recipient', 'recipientId', 'awardedAt', 'awardNote', 'decision', 'phaseNo', 'rev', 'createdBy', 'createdAt'])
        && data.rev is int && data.rev == 1
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time
        && data.item is string && data.item.size() >= 1 && data.item.size() <= 120
        && data.encounter is string && data.encounter.size() <= 120
        && data.recipient is string && data.recipient.size() >= 1 && data.recipient.size() <= 60
        && data.recipientId is string && data.recipientId.matches('^[A-Za-z0-9_-]{1,100}$')
        && get(/databases/$(database)/documents/guilds/$(guildId)/roster/$(data.recipientId)).data.name == data.recipient
        && validIsoDate(data.awardedAt)
        && data.awardNote is string && data.awardNote.size() <= 500
        && data.decision in ['roll', 'council', 'other']
        && validPhaseNo(data.phaseNo)
        && data.phaseNo == currentPhaseNo(guildId)
        && writtenNow(auditEntryPath(guildId, 'award', awardId, 1));
    }

    // Audit log. A change to an award is accepted only together with its audit entry, written in the same batch;
    // the entry's own rule (validAuditEntry) ties it back to the change, so each needs the other, and the entry has
    // to describe the change truthfully (which fields, their old and new values, whether it was a removal).
    // The entry id is {targetType}_{targetId}_{rev}. Every edit raises rev by one, so an id can be used once, and the
    // type keeps an award and a priority with the same id from sharing entry ids.
    function auditEntryPath(guildId, targetType, targetId, rev) {
      return /databases/$(database)/documents/guilds/$(guildId)/auditLog/$(targetType + '_' + targetId + '_' + string(rev));
    }

    function unchanged(before, after, field) {
      return (field in after) == (field in before) && after.get(field, null) == before.get(field, null);
    }

    function validAwardEdit(guildId, awardId) {
      let before = resource.data;
      let after = request.resource.data;
      let rev = before.get('rev', 0) + 1;
      let entryPath = auditEntryPath(guildId, 'award', awardId, rev);
      return after.keys().hasOnly(['priorityId', 'item', 'encounter', 'recipient', 'recipientId', 'awardedAt', 'prioritySnapshot', 'prioritySnapshotIds', 'councilNoteSnapshot', 'awardNote', 'decision', 'phaseNo', 'rev', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'status', 'removedReason'])
        && before.get('rev', 0) is int
        && after.rev is int
        && after.rev == rev
        && writtenNow(entryPath)
        && getAfter(entryPath).data.targetType == 'award'
        && getAfter(entryPath).data.targetId == awardId
        && unchanged(before, after, 'priorityId')
        && unchanged(before, after, 'prioritySnapshot')
        && unchanged(before, after, 'prioritySnapshotIds')
        && unchanged(before, after, 'councilNoteSnapshot')
        && unchanged(before, after, 'createdBy')
        && unchanged(before, after, 'createdAt')
        && after.updatedBy == request.auth.uid
        && after.updatedAt == request.time
        && after.item is string && after.item.size() >= 1 && after.item.size() <= 120
        && after.encounter is string && after.encounter.size() <= 120
        && after.recipient is string && after.recipient.size() >= 1 && after.recipient.size() <= 60
        && (after.get('recipientId', null) == null || (after.recipientId is string && after.recipientId.size() <= 100))
        && (!('recipientId' in after) || (unchanged(before, after, 'recipientId') && unchanged(before, after, 'recipient'))
          || (after.recipientId.matches('^[A-Za-z0-9_-]{1,100}$') && get(/databases/$(database)/documents/guilds/$(guildId)/roster/$(after.recipientId)).data.name == after.recipient))
        && validIsoDate(after.awardedAt)
        && after.awardNote is string && after.awardNote.size() <= 500
        && (!('decision' in after) || after.decision in ['roll', 'council', 'other'])
        && (!('phaseNo' in after) || validPhaseNo(after.phaseNo))
        && (unchanged(before, after, 'phaseNo') || after.phaseNo <= currentPhaseNo(guildId))
        && (!('phaseNo' in before) || 'phaseNo' in after)
        && after.get('status', 'active') in ['active', 'removed']
        && (!('removedReason' in after) || (after.removedReason is string && after.removedReason.size() <= 300))
        && (after.get('status', 'active') != 'removed' || (after.get('removedReason', null) is string && after.removedReason.trim().size() >= 1));
    }

    // A raid edit or cancellation is accepted only together with its audit entry (type 'raid'), like an award edit.
    // A cancelled raid stays on the calendar with status 'cancelled' and a reason; it can be put back to
    // 'scheduled', which clears the reason. Raids made before this change have no rev or status (scheduled).
    // Mark Complete (RAID-019) sets status 'complete' (entry action 'complete') and undoing it puts it back to 'scheduled'
    // (an 'edit'). A raid can be complete only once it has a saved start that has passed, never straight from cancelled,
    // and never with a reason; so a complete raid cannot be moved to a future start without undoing it first.
    // The start time, 24-hour HH:MM in Eastern Time. Raids made without one start at the guild's usual 9:00 PM ET.
    function validRaidTime(value) {
      return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function validRaidDescription(value) {
      return value is string && value.size() >= 1 && value.size() <= 500;
    }

    function validRaidZoneSnapshot(zone) {
      // Keep ten-zone audited edits within the expression budget. These methods also enforce
      // map/string types and required fields; the ID pattern includes newlines and Unicode.
      return zone.keys().hasOnly(['id', 'name', 'size'])
        && zone.id.matches('^[\\s\\S]{1,100}$')
        && zone.name.size() <= 80 && zone.name.trim() != ''
        && zone.size in [10, 20, 40];
    }

    function validRaidZones(zones) {
      let count = zones.size();
      return zones is list && count >= 1 && count <= 10
        && validRaidZoneSnapshot(zones[0])
        && (count < 2 || validRaidZoneSnapshot(zones[1]))
        && (count < 3 || validRaidZoneSnapshot(zones[2]))
        && (count < 4 || validRaidZoneSnapshot(zones[3]))
        && (count < 5 || validRaidZoneSnapshot(zones[4]))
        && (count < 6 || validRaidZoneSnapshot(zones[5]))
        && (count < 7 || validRaidZoneSnapshot(zones[6]))
        && (count < 8 || validRaidZoneSnapshot(zones[7]))
        && (count < 9 || validRaidZoneSnapshot(zones[8]))
        && (count < 10 || validRaidZoneSnapshot(zones[9]));
    }

    function validRaidEdit(guildId, raidId) {
      let before = resource.data;
      let after = request.resource.data;
      let rev = before.get('rev', 0) + 1;
      let entryPath = auditEntryPath(guildId, 'raid', raidId, rev);
      return after.keys().hasOnly(['date', 'name', 'size', 'createdBy', 'createdAt', 'rev', 'updatedBy', 'updatedAt', 'status', 'cancelReason', 'description', 'time', 'zones', 'startsAt'])
        && (!('startsAt' in after) || after.startsAt is timestamp)
        && (!('startsAt' in before) || 'startsAt' in after)
        && (!('startsAt' in before) || (unchanged(before, after, 'date') && unchanged(before, after, 'time')) || after.startsAt != before.startsAt)
        && before.get('rev', 0) is int
        && after.rev is int
        && after.rev == rev
        && getAfter(entryPath).data.targetType == 'raid'
        && getAfter(entryPath).data.targetId == raidId
        && unchanged(before, after, 'createdBy')
        && unchanged(before, after, 'createdAt')
        && after.updatedBy == request.auth.uid
        && after.updatedAt == request.time
        && validIsoDate(after.date)
        && after.name is string && after.name.size() >= 1 && after.name.size() <= 80
        && after.size in [10, 20, 40]
        && (!('description' in after) || validRaidDescription(after.description))
        && (!('time' in after) || validRaidTime(after.time))
        && (!('zones' in after) || validRaidZones(after.zones))
        && after.get('status', 'scheduled') in ['scheduled', 'cancelled', 'complete']
        && (!('cancelReason' in after) || (after.cancelReason is string && after.cancelReason.size() <= 300))
        && (after.get('status', 'scheduled') != 'cancelled' || (after.get('cancelReason', null) is string && after.cancelReason.trim().size() >= 1))
        && (after.get('status', 'scheduled') == 'cancelled' || !('cancelReason' in after))
        && (after.get('status', 'scheduled') != 'complete'
          || ('startsAt' in after && after.startsAt <= request.time && before.get('status', 'scheduled') != 'cancelled'));
    }

    // get() and getAfter() of a document that is not there are errors, and an error denies the request. So the
    // checks below that read the target (or the entry) also prove it exists, and are not repeated as exists() calls:
    // every lookup counts against the limit of 20 per batch.
    //
    // One field of an entry: if the entry lists it as changed, its before and after values must be what the stored
    // document had and has.
    function auditFieldLogged(data, oldDoc, newDoc, field) {
      return !(field in data.changed)
        || (data.get('before', {}).get(field, null) == oldDoc.get(field, null)
          && data.get('after', {}).get(field, null) == newDoc.get(field, null));
    }

    // Headroom: the entry rule of the widest first creature document (11 listed fields) has room for only about 60 more expressions under the 1000 a request
    // may use (measured by padding it), so a new field or check here must re-run the widest tests in tests/rules/loot-tables.test.ts and batch-budget.test.ts.
    // The table fields of an entry, each checked as auditFieldLogged does, but with the entry's lists looked up once and the fields written out: a first
    // creature document lists 11 fields, and a function call per field would not leave the entry rule room within the 1000 expressions a request may use.
    function tableFieldsLogged(data, oldDoc, newDoc) {
      let changed = data.changed;
      let before = data.get('before', {});
      let after = data.get('after', {});
      return (!('type' in changed) || (before.get('type', null) == oldDoc.get('type', null) && after.get('type', null) == newDoc.get('type', null)))
        && (!('zoneId' in changed) || (before.get('zoneId', null) == oldDoc.get('zoneId', null) && after.get('zoneId', null) == newDoc.get('zoneId', null)))
        && (!('key' in changed) || (before.get('key', null) == oldDoc.get('key', null) && after.get('key', null) == newDoc.get('key', null)))
        && (!('phaseNo' in changed) || (before.get('phaseNo', null) == oldDoc.get('phaseNo', null) && after.get('phaseNo', null) == newDoc.get('phaseNo', null)))
        && (!('follows' in changed) || (before.get('follows', null) == oldDoc.get('follows', null) && after.get('follows', null) == newDoc.get('follows', null)))
        && (!('name' in changed) || (before.get('name', null) == oldDoc.get('name', null) && after.get('name', null) == newDoc.get('name', null)))
        && (!('kind' in changed) || (before.get('kind', null) == oldDoc.get('kind', null) && after.get('kind', null) == newDoc.get('kind', null)))
        && (!('players' in changed) || (before.get('players', null) == oldDoc.get('players', null) && after.get('players', null) == newDoc.get('players', null)))
        && (!('npcId' in changed) || (before.get('npcId', null) == oldDoc.get('npcId', null) && after.get('npcId', null) == newDoc.get('npcId', null)))
        && (!('order' in changed) || (before.get('order', null) == oldDoc.get('order', null) && after.get('order', null) == newDoc.get('order', null)))
        && (!('itemIds' in changed) || (before.get('itemIds', null) == oldDoc.get('itemIds', null) && after.get('itemIds', null) == newDoc.get('itemIds', null)))
        && (!('hiddenItemIds' in changed) || (before.get('hiddenItemIds', null) == oldDoc.get('hiddenItemIds', null) && after.get('hiddenItemIds', null) == newDoc.get('hiddenItemIds', null)))
        && (!('removed' in changed) || (before.get('removed', null) == oldDoc.get('removed', null) && after.get('removed', null) == newDoc.get('removed', null)));
    }

    // The award fields of an entry, written out like the table fields (the entry's lists looked up once) so that the widest entry, a new award from a priority
    // with its recipient id and snapshot ids, stays inside the 1000 expressions a request may use. A function call per field (auditFieldLogged) went over
    // it. Headroom, measured by padding auditDescribesChange with `&& (true == true)`: the widest creature, award and priority entries still pass with 16
    // of those (about 60 expressions) and fail with 20, so a new field or check here must re-run the widest tests in roster-ids.test.ts, loot-tables.test.ts
    // and batch-budget.test.ts.
    function awardFieldsLogged(data, oldDoc, newDoc) {
      let changed = data.changed;
      let before = data.get('before', {});
      let after = data.get('after', {});
      return (!('item' in changed) || (before.get('item', null) == oldDoc.get('item', null) && after.get('item', null) == newDoc.get('item', null)))
        && (!('encounter' in changed) || (before.get('encounter', null) == oldDoc.get('encounter', null) && after.get('encounter', null) == newDoc.get('encounter', null)))
        && (!('recipient' in changed) || (before.get('recipient', null) == oldDoc.get('recipient', null) && after.get('recipient', null) == newDoc.get('recipient', null)))
        && (!('recipientId' in changed) || (before.get('recipientId', null) == oldDoc.get('recipientId', null) && after.get('recipientId', null) == newDoc.get('recipientId', null)))
        && (!('awardedAt' in changed) || (before.get('awardedAt', null) == oldDoc.get('awardedAt', null) && after.get('awardedAt', null) == newDoc.get('awardedAt', null)))
        && (!('awardNote' in changed) || (before.get('awardNote', null) == oldDoc.get('awardNote', null) && after.get('awardNote', null) == newDoc.get('awardNote', null)))
        && (!('decision' in changed) || (before.get('decision', null) == oldDoc.get('decision', null) && after.get('decision', null) == newDoc.get('decision', null)))
        && (!('phaseNo' in changed) || (before.get('phaseNo', null) == oldDoc.get('phaseNo', null) && after.get('phaseNo', null) == newDoc.get('phaseNo', null)))
        && (!('status' in changed) || (before.get('status', null) == oldDoc.get('status', null) && after.get('status', null) == newDoc.get('status', null)))
        && (!('removedReason' in changed) || (before.get('removedReason', null) == oldDoc.get('removedReason', null) && after.get('removedReason', null) == newDoc.get('removedReason', null)))
        && (!('priorityId' in changed) || (before.get('priorityId', null) == oldDoc.get('priorityId', null) && after.get('priorityId', null) == newDoc.get('priorityId', null)))
        && (!('prioritySnapshot' in changed) || (before.get('prioritySnapshot', null) == oldDoc.get('prioritySnapshot', null) && after.get('prioritySnapshot', null) == newDoc.get('prioritySnapshot', null)))
        && (!('prioritySnapshotIds' in changed) || (before.get('prioritySnapshotIds', null) == oldDoc.get('prioritySnapshotIds', null) && after.get('prioritySnapshotIds', null) == newDoc.get('prioritySnapshotIds', null)))
        && (!('councilNoteSnapshot' in changed) || (before.get('councilNoteSnapshot', null) == oldDoc.get('councilNoteSnapshot', null) && after.get('councilNoteSnapshot', null) == newDoc.get('councilNoteSnapshot', null)));
    }

    // The priority fields of an entry, the same way.
    function priorityFieldsLogged(data, oldDoc, newDoc) {
      let changed = data.changed;
      let before = data.get('before', {});
      let after = data.get('after', {});
      return (!('item' in changed) || (before.get('item', null) == oldDoc.get('item', null) && after.get('item', null) == newDoc.get('item', null)))
        && (!('encounter' in changed) || (before.get('encounter', null) == oldDoc.get('encounter', null) && after.get('encounter', null) == newDoc.get('encounter', null)))
        && (!('rankedPlayers' in changed) || (before.get('rankedPlayers', null) == oldDoc.get('rankedPlayers', null) && after.get('rankedPlayers', null) == newDoc.get('rankedPlayers', null)))
        && (!('rankedIds' in changed) || (before.get('rankedIds', null) == oldDoc.get('rankedIds', null) && after.get('rankedIds', null) == newDoc.get('rankedIds', null)))
        && (!('councilNote' in changed) || (before.get('councilNote', null) == oldDoc.get('councilNote', null) && after.get('councilNote', null) == newDoc.get('councilNote', null)))
        && (!('itemId' in changed) || (before.get('itemId', null) == oldDoc.get('itemId', null) && after.get('itemId', null) == newDoc.get('itemId', null)))
        && (!('zoneId' in changed) || (before.get('zoneId', null) == oldDoc.get('zoneId', null) && after.get('zoneId', null) == newDoc.get('zoneId', null)))
        && (!('npcId' in changed) || (before.get('npcId', null) == oldDoc.get('npcId', null) && after.get('npcId', null) == newDoc.get('npcId', null)))
        && (!('phaseNo' in changed) || (before.get('phaseNo', null) == oldDoc.get('phaseNo', null) && after.get('phaseNo', null) == newDoc.get('phaseNo', null)))
        && (!('carriedFrom' in changed) || (before.get('carriedFrom', null) == oldDoc.get('carriedFrom', null) && after.get('carriedFrom', null) == newDoc.get('carriedFrom', null)))
        && (!('hidden' in changed) || (before.get('hidden', null) == oldDoc.get('hidden', null) && after.get('hidden', null) == newDoc.get('hidden', null)));
    }

    // The item label is the item as it was before the change (as created, for a create).
    // The entry has to say exactly what happened to the target: the fields that differ between the document before
    // and after the batch (a created document has no "before", a deleted one no "after"), with their old and new values.
    // A raid entry says 'complete' exactly when the batch marks the raid complete (RAID-019), as 'cancel' does for cancelling.
    function auditDescribesChange(data, oldDoc, newDoc) {
      let award = data.targetType == 'award';
      let raid = data.targetType == 'raid';
      let table = data.targetType == 'table';
      // What the entry's action, status and reason are called for this target: an award is removed, a raid cancelled.
      let ending = raid ? 'cancel' : 'remove';
      let endStatus = raid ? 'cancelled' : 'removed';
      let startStatus = raid ? 'scheduled' : 'active';
      let reasonField = raid ? 'cancelReason' : 'removedReason';
      let labelField = raid || table ? 'name' : 'item';
      let fields = raid
        ? ['name', 'date', 'time', 'size', 'description', 'zones', 'status', 'cancelReason', 'startsAt']
        : award
          ? ['item', 'encounter', 'recipient', 'recipientId', 'awardedAt', 'awardNote', 'decision', 'phaseNo', 'status', 'removedReason', 'priorityId', 'prioritySnapshot', 'prioritySnapshotIds', 'councilNoteSnapshot']
          : table
            ? ['type', 'zoneId', 'key', 'phaseNo', 'name', 'kind', 'players', 'npcId', 'order', 'itemIds', 'hiddenItemIds', 'removed']
            : ['item', 'encounter', 'rankedPlayers', 'rankedIds', 'councilNote', 'itemId', 'zoneId', 'npcId', 'phaseNo', 'carriedFrom', 'hidden'];
      let touched = newDoc.diff(oldDoc).affectedKeys().difference(['rev', 'updatedBy', 'updatedAt', 'createdBy', 'createdAt'].toSet());
      // (a phase document also lists `follows`; it is added here and not in the list above)
      return touched.hasOnly(table ? fields.concat(['follows']) : fields)
        && data.changed.toSet() == touched
        && data.changed.size() == touched.size()
        && data.get('before', {}).keys().hasOnly(data.changed)
        && data.get('after', {}).keys().hasOnly(data.changed)
        && (raid
          ? auditFieldLogged(data, oldDoc, newDoc, 'name')
            && auditFieldLogged(data, oldDoc, newDoc, 'date')
            && auditFieldLogged(data, oldDoc, newDoc, 'size')
            && auditFieldLogged(data, oldDoc, newDoc, 'status')
            && auditFieldLogged(data, oldDoc, newDoc, 'cancelReason')
            && auditFieldLogged(data, oldDoc, newDoc, 'description')
            && auditFieldLogged(data, oldDoc, newDoc, 'zones')
            && auditFieldLogged(data, oldDoc, newDoc, 'time')
            && auditFieldLogged(data, oldDoc, newDoc, 'startsAt')
            && (data.action == 'complete') == (newDoc.get('status', 'scheduled') == 'complete' && oldDoc.get('status', 'scheduled') != 'complete')
          : award
            ? awardFieldsLogged(data, oldDoc, newDoc)
            : table
              ? tableFieldsLogged(data, oldDoc, newDoc)
              : priorityFieldsLogged(data, oldDoc, newDoc))
        && data.item == (data.action == 'create' ? newDoc.get(labelField, '') : oldDoc.get(labelField, ''))
        && (data.action == ending) == (newDoc.get('status', startStatus) == endStatus && oldDoc.get('status', startStatus) != endStatus)
        && (data.action != ending || data.get('reason', '') == newDoc.get(reasonField, ''))
        && (data.action != 'reorder' || ('rankedPlayers' in data.changed && data.changed.hasOnly(['rankedPlayers', 'rankedIds'])
          && data.get('before', {}).get('rankedPlayers', []).toSet() == data.get('after', {}).get('rankedPlayers', []).toSet()
          && data.get('before', {}).get('rankedIds', []).toSet() == data.get('after', {}).get('rankedIds', []).toSet()));
    }

    function validAuditEntry(guildId, entryId) {
      let data = request.resource.data;
      let targetPath = data.targetType == 'award'
        ? /databases/$(database)/documents/guilds/$(guildId)/awards/$(data.targetId)
        : data.targetType == 'raid'
          ? /databases/$(database)/documents/guilds/$(guildId)/raids/$(data.targetId)
          : data.targetType == 'table'
            ? /databases/$(database)/documents/guilds/$(guildId)/lootTables/$(data.targetId)
            : /databases/$(database)/documents/guilds/$(guildId)/lootPriorities/$(data.targetId);
      return data.keys().hasOnly(['at', 'by', 'byName', 'targetType', 'targetId', 'rev', 'action', 'item', 'changed', 'before', 'after', 'reason'])
        && data.keys().hasAll(['at', 'by', 'byName', 'targetType', 'targetId', 'rev', 'action', 'item', 'changed'])
        && data.at == request.time
        && data.by == request.auth.uid
        && data.byName is string && data.byName.size() <= 100
        && data.byName == get(memberPath(guildId, request.auth.uid)).data.get('displayName', '')
        && data.targetType in ['award', 'priority', 'raid', 'phase', 'table']
        && data.targetId is string && data.targetId.matches('^[A-Za-z0-9_-]{1,100}$')
        && data.rev is int && data.rev >= 1
        && entryId == data.targetType + '_' + data.targetId + '_' + string(data.rev)
        && (data.targetType == 'raid' ? data.action in ['edit', 'cancel', 'complete'] : data.targetType == 'phase' ? data.action in ['start', 'reopen', 'edit'] : data.targetType == 'table' ? data.action in ['create', 'edit'] : data.action in ['create', 'edit', 'remove', 'reorder', 'delete'])
        && (data.targetType != 'award' || data.action in ['create', 'edit', 'remove'])
        && data.item is string && data.item.size() <= 120
        && data.changed is list && data.changed.size() <= 20
        && (!('before' in data) || data.before is map)
        && (!('after' in data) || data.after is map)
        && (!('reason' in data) || (data.reason is string && data.reason.size() <= 300))
        && (!(data.action in ['remove', 'cancel']) || ('reason' in data && data.reason.trim().size() >= 1))
        && (data.targetType == 'phase' ? validPhaseEntry(guildId, data) : data.action == 'create'
          ? data.rev == 1 && !exists(targetPath) && getAfter(targetPath).data.get('rev', 0) is int && getAfter(targetPath).data.get('rev', 0) == 1
            && (data.targetType != 'award' || getAfter(targetPath).data.get('createdBy', data.by) == data.by)
            && auditDescribesChange(data, {}, getAfter(targetPath).data)
          : data.action == 'delete'
            ? !existsAfter(targetPath) && data.rev == get(targetPath).data.get('rev', 0) + 1
              && auditDescribesChange(data, get(targetPath).data, {})
            : data.rev == get(targetPath).data.get('rev', 0) + 1
              && getAfter(targetPath).data.get('rev', 0) == data.rev
              && auditDescribesChange(data, get(targetPath).data, getAfter(targetPath).data));
    }

    // The entry for starting or reopening a loot phase, or for changing the phase start dates (type 'phase', id phase_settings_{n}, n counting
    // every start, reopen and change of the dates). The settings document is the target and its `phaseRev` is the revision. The entry lists
    // exactly the phase fields (currentPhase, nextPhase, phaseHistory, phaseStarts) that differ between what was stored and what the batch stores,
    // with their old and new values; a first save has nothing stored, so those fields read as nothing before. Other settings changed in the same
    // save (the status label, say) are not part of the entry. The action is 'start' exactly when the history grows, 'reopen' exactly when it
    // shrinks, and 'edit' when it stays as it is (only the start dates can then have moved the revision, see validPhaseRev). Every change of the
    // start dates needs this entry, so it is here that their order is checked (phaseStartsKeepOrder), within this entry's own budget.
    function validPhaseEntry(guildId, data) {
      let path = /databases/$(database)/documents/guilds/$(guildId)/settings/general;
      let oldDoc = exists(path) ? get(path).data : {};
      let newDoc = getAfter(path).data;
      let touched = newDoc.diff(oldDoc).affectedKeys().intersection(['currentPhase', 'nextPhase', 'phaseHistory', 'phaseStarts'].toSet());
      let oldSize = oldDoc.get('phaseHistory', []).size();
      let newSize = newDoc.get('phaseHistory', []).size();
      return data.targetId == 'settings'
        && data.rev == oldDoc.get('phaseRev', 0) + 1
        && newDoc.get('phaseRev', 0) == data.rev
        && data.item == newDoc.currentPhase
        && data.changed.toSet() == touched
        && data.changed.size() == touched.size()
        && data.get('before', {}).keys().hasOnly(data.changed)
        && data.get('after', {}).keys().hasOnly(data.changed)
        && auditFieldLogged(data, oldDoc, newDoc, 'currentPhase')
        && auditFieldLogged(data, oldDoc, newDoc, 'nextPhase')
        && auditFieldLogged(data, oldDoc, newDoc, 'phaseHistory')
        && auditFieldLogged(data, oldDoc, newDoc, 'phaseStarts')
        && (data.action == 'start') == (newSize > oldSize)
        && (data.action == 'reopen') == (newSize < oldSize)
        && (!('phaseStarts' in touched) || phaseStartsKeepOrder(oldDoc.get('phaseStarts', []), newDoc.get('phaseStarts', [])));
    }

    // Whether the start dates a batch stores are in order, knowing the stored ones were (they passed these rules). Dates taken off the end (a
    // reopen) keep the order, and one date added after the last (a start, with blanks for the phases between) keeps it when it is not before
    // the last stored date, which is the latest (the list ends with a date). These two are checked cheaply, because the widest start and reopen
    // entries have the least room in the 1000 expressions a write may evaluate; any other change (a date set or corrected) checks every pair.
    // An empty range such as [0:0] is an error in the rules, so a prefix is compared only when it is not empty.
    function phaseStartsKeepOrder(stored, starts) {
      let o = stored.size();
      let n = starts.size();
      return (n < o && (n == 0 || stored[0:n] == starts))
        || (n > o && (o == 0 || starts[0:o] == stored) && starts[o:n].removeAll(['']) == [starts[n - 1]] && (o == 0 || stored[o - 1] <= starts[n - 1]))
        || phaseStartsInOrder(starts.removeAll(['']));
    }

    function validLabel(value) {
      return value is string && value.size() >= 1 && value.size() <= 40;
    }

    // The loot phases. The number of the current phase is the length of `phaseHistory`, the names of the finished phases, oldest first
    // (a guild that never closed one has none). The list can change in only two ways, so a leader cannot quietly move the phase back or
    // rewrite its history: starting a phase appends the name the current phase had (and `currentPhase` becomes the new name), and
    // reopening the last one takes its name off the end (it becomes `currentPhase` again, and the name of the phase being left becomes
    // `nextPhase`). Every name in the list was a valid current phase name when it was written, so no entry needs checking here.
    // The first save of a guild's settings has nothing stored to compare with. The app shows 'Launch prep' as the current phase until
    // then (defaultGuildSettings), so that is the one name a first save may close. (An empty range such as [0:0] is an error in the
    // rules, so a prefix is compared only when it is not empty.)
    function validPhaseSteps(old, after) {
      let data = request.resource.data;
      let before = old.get('phaseHistory', []);
      return before is list
        && (after == before
          || (after.size() == before.size() + 1 && (before.size() == 0 || after[0:before.size()] == before) && after[before.size()] == old.currentPhase)
          || (after.size() + 1 == before.size() && (after.size() == 0 || before[0:after.size()] == after) && data.currentPhase == before[after.size()] && data.nextPhase == old.currentPhase));
    }

    function validPhaseHistory() {
      let after = request.resource.data.get('phaseHistory', []);
      return after is list && after.size() <= 30
        && (resource == null
          ? (after.size() == 0 || (after.size() == 1 && after[0] == 'Launch prep'))
          : validPhaseSteps(resource.data, after));
    }

    // Starting or reopening a phase (the history changes), and changing the phase start dates, are each one more step of `phaseRev` and need
    // their change log entry in the same batch (see validPhaseEntry). A save that leaves the history and the dates alone, a rename of the current
    // phase included, leaves `phaseRev` alone and needs none.
    function validPhaseRev(guildId) {
      let data = request.resource.data;
      let old = resource == null ? {} : resource.data;
      let rev = data.get('phaseRev', 0);
      return rev is int && rev >= 0 && rev <= 1000000
        && (data.get('phaseHistory', []) != old.get('phaseHistory', []) || data.get('phaseStarts', []) != old.get('phaseStarts', [])
          ? rev == old.get('phaseRev', 0) + 1 && writtenNow(auditEntryPath(guildId, 'phase', 'settings', rev))
          : rev == old.get('phaseRev', 0));
    }

    // RAID-019: the day each loot phase started (`phaseStarts`, optional), one entry per phase in the order of their numbers (the finished phases,
    // oldest first, then the current one), each an Eastern calendar date "YYYY-MM-DD", or '' for a phase whose start is not known. It has no more
    // entries than there are phases, so reopening a phase takes its date away in the same save, and its last entry is a date (the list is never
    // padded at the end). A change of the list is a step of `phaseRev` with its entry (validPhaseRev), and only a Guild Leader writes the settings.
    // The rules cannot loop over a list, so the entries are checked joined into one text: every entry is text made of digits and hyphens only (so
    // none holds a separator of its own), and each piece between the separators is a date or nothing. A list that did not change is not checked
    // again, but its length is, because a reopen shortens the phases. That the dates never go backwards is checked by the entry the change needs
    // (validPhaseEntry, phaseStartsInOrder): this document's own rules are close to the 1000 expressions one write may evaluate.
    function validPhaseStarts() {
      let data = request.resource.data;
      let starts = data.get('phaseStarts', []);
      return starts is list
        && starts.size() <= data.get('phaseHistory', []).size() + 1
        && (starts.size() == 0 || starts[starts.size() - 1] != '')
        && ((resource != null && starts == resource.data.get('phaseStarts', []))
          || (starts.join('').matches('^[0-9-]*$')
            && starts.join('|').matches('^([0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]))?([|]([0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]))?)*$')));
    }

    // The dates of phaseStarts, blanks taken out, never go backwards (a later phase cannot start before an earlier one; two can start on the same
    // day): each neighboring pair, written out for the 31 a list can have (30 finished phases and the current one). A date is "YYYY-MM-DD", so
    // comparing the texts compares the days. The list is padded with 31 '~', which sorts after every date, so every pair can be compared without
    // first asking whether it is there, which would cost about as much again (the padding is split from one text, which costs less than a list of
    // 31 written out). tests/rules/settings.test.ts checks the widest writes.
    function phaseStartsInOrder(dates) {
      let d = dates.concat('~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~'.split(' '));
      return d[0] <= d[1] && d[1] <= d[2] && d[2] <= d[3] && d[3] <= d[4] && d[4] <= d[5] && d[5] <= d[6] && d[6] <= d[7] && d[7] <= d[8] && d[8] <= d[9] && d[9] <= d[10]
        && d[10] <= d[11] && d[11] <= d[12] && d[12] <= d[13] && d[13] <= d[14] && d[14] <= d[15] && d[15] <= d[16] && d[16] <= d[17] && d[17] <= d[18] && d[18] <= d[19] && d[19] <= d[20]
        && d[20] <= d[21] && d[21] <= d[22] && d[22] <= d[23] && d[23] <= d[24] && d[24] <= d[25] && d[25] <= d[26] && d[26] <= d[27] && d[27] <= d[28] && d[28] <= d[29] && d[29] <= d[30];
    }

    // The colors of the zones (guilds/{id}/settings/zoneColors, a document of its own so that a save of the general settings from an older app cannot wipe
    // it): `colors` maps a zone's key to a #rrggbb color the guild chose (the zone's number, or r- and the id of a zone of the older raid zone list), and only
    // a Guild Leader writes it. The rules can count the entries but cannot look
    // at each key and value (a map cannot be looped over), so the app reads the map safely (readZoneColors) and ignores whatever is not a zone key with a
    // valid color. Stamped by the rules like the other documents; the colors are cosmetic, so a change is not logged.
    function validZoneColors() {
      let data = request.resource.data;
      return data.keys().hasOnly(['colors', 'updatedBy', 'updatedAt'])
        && data.keys().hasAll(['colors', 'updatedBy', 'updatedAt'])
        && data.colors is map
        && data.colors.size() <= 200
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    // The zone artwork (guilds/{id}/settings/zoneArt, a document of its own like the colors): `images` is the list of pictures a Guild Leader uploaded to Cloud
    // Storage (a map from the picture's id to its name, address, size and rev, at most 200) and `art` says which picture each zone uses (a map from a zone's
    // key, as for the colors, to a picture's id, at most 200). Only a Guild Leader writes it, and the files themselves are governed by storage.rules. As
    // with the colors the rules can count the entries but cannot look at each one, so the app reads both maps safely (readZoneArt) and ignores an entry that
    // is not a picture of this guild's storage or a zone that is not there. Cosmetic, so a change is not logged.
    function validZoneArt() {
      let data = request.resource.data;
      return data.keys().hasOnly(['images', 'art', 'updatedBy', 'updatedAt'])
        && data.keys().hasAll(['images', 'art', 'updatedBy', 'updatedAt'])
        && data.images is map
        && data.images.size() <= 200
        && data.art is map
        && data.art.size() <= 200
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    function validGuildSettings(guildId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['currentPhase', 'nextPhase', 'currentStatusLabel', 'currentStatusTone', 'nextStatusLabel', 'nextStatusTone', 'councilStatus', 'teamNames', 'groupNames', 'phaseHistory', 'phaseRev', 'phaseStarts'])
        && validPhaseHistory()
        && validPhaseRev(guildId)
        && validPhaseStarts()
        && data.keys().hasAll(['currentPhase', 'nextPhase', 'currentStatusLabel', 'currentStatusTone', 'nextStatusLabel', 'nextStatusTone', 'councilStatus', 'teamNames', 'groupNames'])
        && validLabel(data.currentPhase)
        && validLabel(data.nextPhase)
        && validLabel(data.currentStatusLabel)
        && validLabel(data.nextStatusLabel)
        && data.currentStatusTone in ['active', 'preparing', 'paused']
        && data.nextStatusTone in ['active', 'preparing', 'paused']
        && data.councilStatus in ['deliberating', 'live']
        && data.teamNames is map
        && data.teamNames.keys().hasOnly(['blue', 'yellow', 'red', 'white'])
        && data.teamNames.keys().hasAll(['blue', 'yellow', 'red', 'white'])
        && validLabel(data.teamNames.blue)
        && validLabel(data.teamNames.yellow)
        && validLabel(data.teamNames.red)
        && validLabel(data.teamNames.white)
        && data.groupNames is map
        && data.groupNames.keys().hasOnly(['green', 'pink', 'brown'])
        && data.groupNames.keys().hasAll(['green', 'pink', 'brown'])
        && validLabel(data.groupNames.green)
        && validLabel(data.groupNames.pink)
        && validLabel(data.groupNames.brown);
    }

    function validTeamAssignment() {
      return request.resource.data.keys().hasOnly(['team'])
        && request.resource.data.team in ['blue', 'yellow', 'red', 'white'];
    }

    function validIsoDate(date) {
      return date is string && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    match /guilds/{guildId} {
      allow read: if hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member']);
      allow write: if false;

      match /members/{userId} {
        allow get: if signedIn() && (request.auth.uid == userId || isGuildLeader(guildId));
        allow list: if isGuildLeader(guildId);
        allow create: if isGuildLeader(guildId) && hasValidRole() && hasValidPlayerLink(guildId, userId);
        allow update: if isGuildLeader(guildId)
          && validMemberAccessChange(userId)
          && hasValidPlayerLink(guildId, userId)
          && releasesPreviousPlayerLink(guildId, userId);
        allow delete: if false;
      }

      match /roster/{playerId} {
        allow read: if hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member']);
        allow create: if isGuildLeader(guildId) && hasValidRosterLink(guildId, playerId);
        allow update: if isGuildLeader(guildId)
          && hasValidRosterLink(guildId, playerId)
          && releasesPreviousMemberLink(guildId, playerId);
        allow delete: if isGuildLeader(guildId)
          && (resource.data.get('linkedUid', null) == null
            || getAfter(memberPath(guildId, resource.data.linkedUid)).data.get('playerId', null) == null);
      }

      match /characterReadiness/{playerId} {
        function ownsCharacter() {
          let member = get(memberPath(guildId, request.auth.uid)).data;
          let mainId = member.get('playerId', '');
          let main = get(/databases/$(database)/documents/guilds/$(guildId)/roster/$(mainId)).data;
          let character = get(/databases/$(database)/documents/guilds/$(guildId)/roster/$(playerId)).data;
          return main.linkedUid == request.auth.uid
            && main.get('mainId', null) == null
            && (playerId == mainId
              || (character.get('mainId', null) == mainId && character.get('linkedUid', null) == null));
        }
        allow read: if hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member']);
        allow create, update: if hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member'])
          && exists(/databases/$(database)/documents/guilds/$(guildId)/roster/$(playerId))
          && (isGuildLeader(guildId) || ownsCharacter())
          && request.resource.data.keys().hasOnly(['ready', 'updatedBy', 'updatedAt'])
          && request.resource.data.keys().hasAll(['ready', 'updatedBy', 'updatedAt'])
          && request.resource.data.ready is bool
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /teamAssignments/{playerId} {
        allow read: if hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member']);
        allow create, update: if canManageRaid(guildId) && validTeamAssignment();
        allow delete: if canManageRaid(guildId);
      }
      match /teamAssignments20/{playerId} {
        allow read: if hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member']);
        allow write: if false;
      }
      match /teamAssignments40/{playerId} {
        allow read: if hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member']);
        allow write: if false;
      }

      match /raidZones/{zoneId} {
        allow read: if hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member']);
        allow create, update: if isGuildLeader(guildId)
          && request.resource.data.keys().hasOnly(['name', 'size'])
          && request.resource.data.keys().hasAll(['name', 'size'])
          && request.resource.data.name is string
          && request.resource.data.name.trim().size() >= 1
          && request.resource.data.name.size() <= 80
          && request.resource.data.size in [10, 20, 40];
        allow delete: if isGuildLeader(guildId);
      }

      match /settings/{settingId} {
        allow read: if hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member']);
        allow create, update: if (settingId == 'general' && isGuildLeader(guildId) && validGuildSettings(guildId))
          || (settingId == 'zoneColors' && isGuildLeader(guildId) && validZoneColors())
          || (settingId == 'zoneArt' && isGuildLeader(guildId) && validZoneArt());
        allow delete: if false;
      }

      match /lootPriorities/{priorityId} {
        allow read: if hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member']);
        allow create: if canManageRaid(guildId) && validPriorityCreate(guildId, priorityId);
        allow update: if canManageRaid(guildId) && validPriorityEdit(guildId, priorityId);
        allow delete: if canManageRaid(guildId) && validPriorityDelete(guildId, priorityId);
      }

      match /lootTables/{tableId} {
        allow read: if hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member']);
        allow create: if canManageRaid(guildId) && validTableCreate(guildId, tableId);
        allow update: if canManageRaid(guildId) && validTableEdit(guildId, tableId);
        allow delete: if false;
      }

      match /awards/{awardId} {
        allow read: if hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member']);
        allow create: if canManageRaid(guildId)
          && (!('priorityId' in request.resource.data) ? validManualAward(guildId, awardId) : validPriorityAward(guildId, awardId));
        allow update: if canManageRaid(guildId) && validAwardEdit(guildId, awardId);
        allow delete: if false;
      }

      match /auditLog/{entryId} {
        allow read: if hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member']);
        allow create: if canManageRaid(guildId) && validAuditEntry(guildId, entryId);
        allow update, delete: if false;
      }

      match /afkEntries/{entryId} {
        allow read: if hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member']);
        // Authenticated callables serialize availability and response changes on the server.
        allow write: if false;
      }

      // A member's own comment, one document per author (the id is the uid) so each member has one of each
      // kind to edit. publicComments can be read by every member; leaderComments only by Guild and Raid
      // Leaders and the author. Only the author writes or deletes, and nobody else, leaders included.
      match /publicComments/{userId} {
        allow read: if hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member']);
        allow create, update: if userId == request.auth.uid && validMemberComment(guildId);
        allow delete: if userId == request.auth.uid && hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member']);
      }

      match /leaderComments/{userId} {
        allow read: if canManageRaid(guildId)
          || (userId == request.auth.uid && hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member']));
        allow create, update: if userId == request.auth.uid && validMemberComment(guildId);
        allow delete: if userId == request.auth.uid && hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member']);
      }

      // A member's own raider type (casual or hardcore), one document per member (the id is the uid).
      // Every member can read them; only the owner writes or removes theirs.
      match /raiderTypes/{userId} {
        allow read: if hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member']);
        allow create, update: if userId == request.auth.uid
          && hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member'])
          && request.resource.data.keys().hasOnly(['userId', 'type', 'updatedAt'])
          && request.resource.data.keys().hasAll(['userId', 'type', 'updatedAt'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.type in ['casual', 'hardcore']
          && request.resource.data.updatedAt == request.time;
        allow delete: if userId == request.auth.uid && hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member']);
      }

      match /raids/{raidId} {
        allow read: if hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member']);
        allow create: if canManageRaid(guildId)
          && request.resource.data.keys().hasOnly(['date', 'time', 'name', 'size', 'createdBy', 'createdAt', 'description', 'zones', 'startsAt'])
          && (!('startsAt' in request.resource.data) || request.resource.data.startsAt is timestamp)
          && (!('description' in request.resource.data) || validRaidDescription(request.resource.data.description))
          && (!('time' in request.resource.data) || validRaidTime(request.resource.data.time))
          && (!('zones' in request.resource.data) || validRaidZones(request.resource.data.zones))
          && validIsoDate(request.resource.data.date)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.size in [10, 20, 40]
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if canManageRaid(guildId) && validRaidEdit(guildId, raidId);
        allow delete: if false;

        match /signups/{userId} {
          allow read: if hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member']);
          allow write: if false;
        }
        match /planning/{planId} {
          allow read: if hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member']);
          allow write: if false;
        }

        match /snapshots/{snapshotId} {
          allow read: if hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member'])
            && resource.data.status == 'complete';
          allow write: if false;

          match /lineups/{lineupId} {
            allow read: if hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member'])
              && get(/databases/$(database)/documents/guilds/$(guildId)/raids/$(raidId)/snapshots/$(snapshotId)).data.status == 'complete';
            allow write: if false;
          }

          match /characters/{characterId} {
            allow read: if hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member'])
              && get(/databases/$(database)/documents/guilds/$(guildId)/raids/$(raidId)/snapshots/$(snapshotId)).data.status == 'complete';
            allow write: if false;
          }

          match /accounts/{uid} {
            allow read: if hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member'])
              && get(/databases/$(database)/documents/guilds/$(guildId)/raids/$(raidId)/snapshots/$(snapshotId)).data.status == 'complete';
            allow write: if false;
          }
        }
      }

      match /characterRequests/{requestId} {
        allow read: if isGuildLeader(guildId)
          || (hasGuildRole(guildId, ['Guild Leader', 'Raid Leader', 'Member']) && resource.data.userId == request.auth.uid);
        // Callables validate ownership and atomically apply approved roster/account changes.
        allow write: if false;
      }

      match /joinRequests/{userId} {
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.keys().hasOnly(['userId', 'email', 'displayName', 'status', 'requestedAt']);
        allow get: if signedIn() && (request.auth.uid == userId || isGuildLeader(guildId));
        allow list: if isGuildLeader(guildId);
        allow update: if (isGuildLeader(guildId)
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.keys().hasOnly(['userId', 'email', 'displayName', 'status', 'requestedAt', 'assignedRole', 'linkedPlayerId'])
          && (request.resource.data.status != 'approved' || (!exists(memberPath(guildId, userId))
            && request.resource.data.assignedRole in ['Guild Leader', 'Raid Leader', 'Member']
            && request.resource.data.get('linkedPlayerId', null) == getAfter(memberPath(guildId, userId)).data.get('playerId', null)
            && request.resource.data.assignedRole == getAfter(memberPath(guildId, userId)).data.role)))
          || (signedIn()
            && request.auth.uid == userId
            && resource.data.status == 'rejected'
            && request.resource.data.status == 'pending'
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.keys().hasOnly(['userId', 'email', 'displayName', 'status', 'requestedAt']));
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
